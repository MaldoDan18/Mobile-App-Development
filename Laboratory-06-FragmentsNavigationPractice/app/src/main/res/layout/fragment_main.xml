<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/holo_blue_light"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainFragment">

    <Button
        android:id="@+id/nav_to_second_fragment_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:padding="12dp"
        android:text="Go to Second Fragment"
        android:textAllCaps="false"
        android:textSize="24sp"
        app:backgroundTint="@android:color/holo_purple" />

    <Button
        android:id="@+id/nav_to_third_fragment_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:padding="12dp"
        android:text="Go to Third Fragment"
        android:textAllCaps="false"
        android:textSize="24sp"
        app:backgroundTint="@android:color/holo_purple" />

    <Button
        android:id="@+id/nav_to_sec_activity_from_fragment_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:padding="12dp"
        android:text="Go to Actions"
        android:textAllCaps="false"
        android:textSize="24sp"
        app:backgroundTint="@android:color/holo_purple" />

</LinearLayout>